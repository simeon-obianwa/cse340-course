<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Check out our upcoming service projects and get involved:</p>

        <ul>
            <% projects.forEach(function(project) { %>
                <% const formattedDate=new Date(project.date || project.project_date).toLocaleDateString('en-US', {
                    year: 'numeric' , month: 'long' , day: 'numeric' }); %>
                    <li style="margin-bottom: 20px;">
                        <strong>
                            <%= formattedDate %>:
                                <a href="/project/<%= project.project_id %>">
                                    <%= project.title %>
                                </a>
                                (<a href="/organization/<%= project.organization_id %>">
                                    <%= project.organization_name %>
                                </a>)
                        </strong>
                        <br>
                        <em>Location:</em>
                        <%= project.location %>
                            <p>
                                <%= project.description %>
                            </p>
                    </li>
                    <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>