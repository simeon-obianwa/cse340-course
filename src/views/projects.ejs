<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Check out our upcoming service projects and get involved:</p>

        <ul>
            <% projects.forEach(function(project) { %>
                <% // Formats date as: "November 20, 2026" const formattedDate=new
                    Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                    day: 'numeric' }); %>
                    <li style="margin-bottom: 20px;">

                        <strong>
                            <%= formattedDate %>: <%= project.title %> (<%= project.organization_name %>)
                        </strong>
                        <br>
                        <em>Location:</em>
                        <%= project.location %>
                            <p>
                                <%= project.description %>
                            </p>
                    </li>
                    <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>