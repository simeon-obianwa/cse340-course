<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Browse our service projects by the following categories:</p>

        <ul>
            <% categories.forEach(function(category) { %>
                <li style="margin-bottom: 10px;">
                    <strong>
                        <%= category.name %>
                    </strong>
                </li>
                <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>